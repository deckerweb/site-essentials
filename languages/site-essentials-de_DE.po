msgstr "Bewusst deaktiviert"

msgid "Intentionally discouraged: keep this setting"
msgstr "Bewusst deaktiviert: Einstellung beibehalten"

msgid "Interactive rule filters require JavaScript. All settings remain available without JavaScript."
msgstr "Interaktive Regelfilter benötigen JavaScript. Ohne JavaScript bleiben alle Einstellungen verfügbar."

msgid "Invalid GitHub repository URL."
msgstr "Ungültige GitHub-Repository-URL."

msgid "Invalid authentication provider."
msgstr "Ungültiger Authentifizierungsanbieter."

msgid "Invalid destination or local loop"
msgstr "Ungültiges Ziel oder lokale Weiterleitungsschleife"

msgid "Invalid maintenance settings."
msgstr "Ungültige Wartungseinstellungen."

msgid "Invalid network policy."
msgstr "Ungültige Netzwerkvorgabe."

msgid "Invalid selection."
msgstr "Ungültige Auswahl."

msgid "Invalid snapshot"
msgstr "Ungültiger Snapshot"

msgid "Invalid values; neutral fallback is used"
msgstr "Ungültige Werte; neutrale Ersatzwerte werden verwendet"

msgid "Invalid website check action."
