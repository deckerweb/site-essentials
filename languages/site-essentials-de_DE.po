msgstr "Entwurf aktualisiert: %s"

msgid "%s link"
msgstr "Link zu %s"

msgid "%s list"
msgstr "Liste: %s"

msgid "%s list navigation"
msgstr "Listennavigation: %s"

msgid "%s moved to Trash."
msgstr "In den Papierkorb verschoben: %s"

msgid "%s published privately."
msgstr "Privat veröffentlicht: %s"

msgid "%s published."
msgstr "Veröffentlicht: %s"

